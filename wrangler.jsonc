{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The built game (`dist/`, from `npm run build`) is served as static assets by Cloudflare Workers.
  "name": "paper-seas",
  "compatibility_date": "2026-11-21",
  // Served at paper-seas.<account subdomain>.workers.dev.
  "workers_dev": true,
  // No usage telemetry from Wrangler, locally or in CI.
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
  },
}
